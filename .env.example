# ---------------------------------------------------------------------------
# AutoTransformation · 本地配置
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会进仓库。
# ---------------------------------------------------------------------------

# 文本模型：负责整段翻译和点词释义（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 视觉模型：负责把书页照片转录成英文（必须支持图片输入）
# 留空则复用上面的 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL。
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# 书籍背景，会写进提示词，帮助模型选对义项和语气
BOOK_CONTEXT=19 世纪英国小说

# 服务端口与监听地址
PORT=8787
HOST=127.0.0.1

# 单次模型请求超时（毫秒）与图片大小上限（MB）
LLM_TIMEOUT_MS=90000
MAX_UPLOAD_MB=12

# 生词本存放目录（相对项目根目录；已加入 .gitignore）
DATA_DIR=data

# 复习日期与提醒使用的时区、每天提醒时刻
TIMEZONE=Asia/Shanghai
REMIND_AT=07:30

# 可选：把到期提醒推送到企业微信 / Server酱 / ntfy。
# 直接复用 vocabcurve 里 notify.cmd 的那个企业微信 webhook 即可。
# 格式：wecom / serverchan / ntfy / json
PUSH_URL=
PUSH_FORMAT=wecom

# 设为 1 可强制进入演示模式：不调用模型，返回内置示例数据
LLM_MOCK=0
